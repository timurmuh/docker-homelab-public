# Agent / tool scratch
.superpowers/
.capture-tmp/

# Eval data is generated from a local corpus and is never published. The
# derivation and capture code stays tracked; the data does not.
eval/canon/
eval/results/
eval/corpus/*.json
eval/corpus/*.jsonl
