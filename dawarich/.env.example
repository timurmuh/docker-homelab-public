# Dawarich self-hosted configuration.
# Copy to .env and fill in the secrets. Full reference:
# https://dawarich.app/docs/self-hosting/environment-variables/

RAILS_ENV=production
SELF_HOSTED=true

# --- Database ---
# POSTGRES_* configure the db container, DATABASE_* configure the app.
# Keep POSTGRES_PASSWORD and DATABASE_PASSWORD identical.
POSTGRES_USER=postgres
POSTGRES_DB=dawarich_production
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_HOST=dawarich_db
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_NAME=dawarich_production
DATABASE_PASSWORD=CHANGE_ME

# --- Secrets ---
# DATABASE_PASSWORD / POSTGRES_PASSWORD: openssl rand -base64 32
# SECRET_KEY_BASE:                       openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME

# --- Redis ---
REDIS_URL=redis://dawarich_redis:6379

# --- Access ---
APPLICATION_PROTOCOL=https
APPLICATION_HOSTS=dawarich.homelab.example.com,localhost,127.0.0.1,100.64.0.10
DOMAIN=dawarich.homelab.example.com

# --- Misc ---
TIME_ZONE=UTC
STORE_GEODATA=true
