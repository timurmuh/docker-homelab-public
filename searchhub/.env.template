# Copy to .env (git-ignored) or supply these variables from your secret manager.
# The bearer token is required; provider keys are optional and a blank key
# disables that provider.
SEARCHHUB_API_KEY=CHANGE_ME
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
JINA_API_KEY=
CRW_URL=http://crw:3000
# Not a secret: the search chain's preference order. Comment it out to use the
# compiled default (exa,tavily,brave,searxng). A keyless provider keeps its place
# and is skipped; an unknown name fails the container at startup.
SEARCH_ORDER=exa,tavily,brave,searxng
# Not a secret: the fetch chain's preference order. Comment it out to use the
# compiled default (crw,jina,tavily,exa). A keyless provider keeps its place and
# is skipped; an unknown name fails the container at startup.
FETCH_ORDER=crw,jina,tavily,exa
# Not a secret: the per-upstream ceiling for one fetch call, in seconds. 30, not
# the search chain's 15: crw's worst measured page takes 16.96 s. Blank uses the
# compiled default (30); a non-finite or non-positive value stops startup.
FETCH_PROVIDER_TIMEOUT_S=30
